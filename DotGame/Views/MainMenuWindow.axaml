<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DotGameAvalonia.Views.MainMenuWindow"
        Title="DotGame – Main Menu"
        Width="400" Height="300"
        WindowStartupLocation="CenterScreen"
        CanResize="False">
    
    <StackPanel Margin="20" Spacing="15">
        <Button Name="BtnEditor" Height="50" Content="Map Editor" FontSize="18" />
        <Button Name="BtnSpriteEditor" Height="50" Content="Sprite Editor" FontSize="18" />
        <Button Name="BtnTestMap" Height="50" Content="Test Map" FontSize="18" />
        <Button Name="BtnCharCreate" Height="50" Content="Create Character" FontSize="18" />
    </StackPanel>
    
</Window>
