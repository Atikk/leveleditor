<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mg="clr-namespace:AvaloniaInside.MonoGame;assembly=AvaloniaInside.MonoGame"
    xmlns:controls="clr-namespace:Dotgame.Avalonia.Controls"
    x:Class="Dotgame.Avalonia.Views.EditorWindow"
    Title="DotGame Map Editor"
    Width="1500" Height="900"
    WindowStartupLocation="CenterScreen"
    Background="#F3F4F6">

    <DockPanel>
        <!-- Modern Toolbar -->
        <Border DockPanel.Dock="Top" 
                Background="White" 
                Padding="16,8" 
                BorderBrush="#E5E7EB" 
                BorderThickness="0,0,0,1">
            <Grid RowDefinitions="Auto,Auto"
                  ColumnDefinitions="*,Auto">
                <!-- Title Row -->
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Map Editor"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#111827"
                           VerticalAlignment="Center"
                           Margin="0,0,0,4" />
                <StackPanel Grid.Row="0"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center">
                    <TextBlock Text="Ctrl+S Save   Ctrl+P Preview   Ctrl+R Reload Data"
                               FontSize="12"
                               Foreground="#6B7280"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Tools Row -->
                <ScrollViewer Grid.Row="1"
                              Grid.ColumnSpan="2"
                              HorizontalScrollBarVisibility="Visible"
                              VerticalScrollBarVisibility="Disabled"
                              Margin="0,2,0,0">
                    <WrapPanel Name="MainToolBar" Orientation="Horizontal" VerticalAlignment="Center">
                        <WrapPanel.Styles>
                            <Style Selector="WrapPanel > Control">
                                <Setter Property="Margin" Value="0,0,8,8" />
                                <Setter Property="Height" Value="36" />
                            </Style>
                        </WrapPanel.Styles>
                        <ToggleButton Name="ToolBrush" Content="Brush" IsChecked="True" MinWidth="85" />
                        <ToggleButton Name="ToolEraser" Content="Eraser" MinWidth="85" />
                        <ToggleButton Name="ToolFill" Content="Fill" MinWidth="80" />
                        <ToggleButton Name="ToolRect" Content="Rectangle" MinWidth="90" />
                        <ToggleButton Name="ToolLine" Content="Line" MinWidth="80" />
                        <ToggleButton Name="ToolPicker" Content="Picker" MinWidth="85" />
                        <ToggleButton Name="ToolSelect" Content="Select" MinWidth="85" />
                        <ToggleButton Name="ToolStamp" Content="Stamp" MinWidth="85" />
                        <ToggleButton Name="ToolCollision" Content="Collision" MinWidth="95" />
                        
                        <Border Width="2" Height="28" Background="#E5E7EB" Margin="8,0" />
                        
                        <Button Name="BtnUndo" Content="Undo" MinWidth="80" />
                        <Button Name="BtnRedo" Content="Redo" MinWidth="80" />
                        
                        <Border Width="2" Height="28" Background="#E5E7EB" Margin="8,0" />
                        
                        <Button Name="BtnZoomOut" Content="-" Width="38" />
                        <Button Name="BtnZoomReset" Content="100%" Width="70" />
                        <Button Name="BtnZoomIn" Content="+" Width="38" />
                        
                        <Border Width="2" Height="28" Background="#E5E7EB" Margin="8,0" />
                        
                        <Button Name="BtnSaveMap" Content="Save" MinWidth="90" Classes="success" />
                        <Button Name="BtnLoadMap" Content="Load" MinWidth="90" />
                        <Button Name="BtnMonoGamePreview" Content="Preview" MinWidth="100" Classes="primary" />
                        <Button Name="BtnReloadGameData" Content="Reload Data" MinWidth="130" />
                        <Button Name="BtnDiagnosticsToggle" Content="Diagnostics / Logging" MinWidth="170" />
                        <Button Name="BtnSpriteEditor" Content="Sprite Editor" MinWidth="130" />
                    </WrapPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Status Bar -->
    <Border DockPanel.Dock="Bottom" 
        Background="White" 
        Padding="12,6" 
                BorderBrush="#E5E7EB" 
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="20">
                <Border Background="#EEF2FF" 
                        CornerRadius="6" 
                        Padding="10,4">
                    <TextBlock Name="StatusToolText" 
                               Text="Tool: Brush (Tiles)" 
                               Foreground="#4338CA"
                               FontWeight="Medium"
                               FontSize="13" />
                </Border>
                <TextBlock Name="StatusCoordText" 
                           Text="Cursor: --" 
                           Foreground="#6B7280"
                           VerticalAlignment="Center"
                           FontSize="13" />
                <TextBlock Name="StatusTileText" 
                           Text="Tile: --" 
                           Foreground="#6B7280"
                           VerticalAlignment="Center"
                           FontSize="13" />
                <TextBlock Name="StatusZoomText" 
                           Text="Zoom: 100%" 
                           Foreground="#6B7280"
                           VerticalAlignment="Center"
                           FontSize="13" />
                <TextBlock Name="StatusAlertText"
                           Text=""
                           Foreground="#B91C1C"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           FontSize="13"
                           IsVisible="False" />
            </StackPanel>
        </Border>

        <!-- Left Sidebar - Assets -->
        <Border DockPanel.Dock="Left" 
                Width="300" 
                Background="White" 
                BorderBrush="#E5E7EB" 
                BorderThickness="0,0,1,0">
            <TabControl Name="AssetTabs">
                <TabItem Header="Tiles">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14" Spacing="12">
                            <TextBlock Text="Tile Management"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#374151" />
                            
                            <Grid ColumnDefinitions="*,*">
                                <Button Name="BtnLoadSpriteSheet" 
                                        Grid.Column="0"
                                        Content="Load Sheet" 
                                        Margin="0,0,4,0" />
                                <Button Name="BtnSplitSheet" 
                                        Grid.Column="1"
                                        Content="Split"
                                        Margin="4,0,0,0"
                                        Classes="primary" />
                            </Grid>
                            
                            <Grid ColumnDefinitions="*,*">
                                <Button Name="BtnLoadTiles" 
                                        Grid.Column="0"
                                        Content="Import Tiles"
                                        Margin="0,0,4,0" />
                                <Button Name="BtnClearGrid" 
                                        Grid.Column="1"
                                        Content="Clear Map"
                                        Margin="4,0,0,0"
                                        Classes="danger" />
                            </Grid>
                            
                            <Border Background="#F9FAFB"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Grid.Column="0" Text="Tile W" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <NumericUpDown Grid.Column="1" Name="NumTileWidth" Minimum="1" Maximum="512" Value="32" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Grid.Column="0" Text="Tile H" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <NumericUpDown Grid.Column="1" Name="NumTileHeight" Minimum="1" Maximum="512" Value="32" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Grid.Column="0" Text="Spacing" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <NumericUpDown Grid.Column="1" Name="NumSpacing" Minimum="0" Maximum="64" Value="0" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Grid.Column="0" Text="Margin" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <NumericUpDown Grid.Column="1" Name="NumMargin" Minimum="0" Maximum="64" Value="0" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Grid.Column="0" Text="Brush" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <NumericUpDown Grid.Column="1" Name="NumBrushSize" Minimum="1" Maximum="10" Value="1" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Grid.Column="0" Text="Grid" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox Grid.Column="1" Name="CmbGridSize" SelectedIndex="1">
                                            <ComboBoxItem>10</ComboBoxItem>
                                            <ComboBoxItem>20</ComboBoxItem>
                                            <ComboBoxItem>30</ComboBoxItem>
                                            <ComboBoxItem>40</ComboBoxItem>
                                            <ComboBoxItem>50</ComboBoxItem>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            
                            <TextBlock Text="Tile Palette"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#374151" />
                            <Border BorderBrush="#E5E7EB" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Padding="8" 
                                    Background="#F9FAFB">
                                <ScrollViewer Height="340" VerticalScrollBarVisibility="Auto">
                                    <WrapPanel Name="TilePalette" Orientation="Horizontal" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Characters">
                    <StackPanel Margin="14" Spacing="10">
                        <Button Name="BtnAddCharacter" Content="Add Character" Classes="success" />
                        <Button Name="BtnEditCharacter" Content="Edit Selected" />
                        <Border Background="#F9FAFB"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="6">
                            <ListBox Name="CharacterList" Height="300" Background="Transparent" BorderThickness="0">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Add Character" Click="CharacterList_AddMenuItem_Click" />
                                        <MenuItem Header="Edit Character" Click="CharacterList_EditMenuItem_Click" />
                                        <MenuItem Header="Remove Character" Click="CharacterList_RemoveMenuItem_Click" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                            </ListBox>
                        </Border>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Doodads">
                    <StackPanel Margin="14" Spacing="10">
                        <Button Name="BtnAddDoodad" Content="Add Doodad" Classes="success" />
                        <Button Name="BtnEditDoodad" Content="Edit Selected" />
                        <Border Background="#F9FAFB"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="6">
                            <ListBox Name="DoodadList" Height="300" Background="Transparent" BorderThickness="0">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Add Doodad" Click="DoodadList_AddMenuItem_Click" />
                                        <MenuItem Header="Edit Doodad" Click="DoodadList_EditMenuItem_Click" />
                                        <MenuItem Header="Remove Doodad" Click="DoodadList_RemoveMenuItem_Click" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                            </ListBox>
                        </Border>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Triggers">
                    <StackPanel Margin="14" Spacing="10">
                        <Button Name="BtnAddTrigger" Content="New Trigger" Classes="success" />
                        <Button Name="BtnRemoveTrigger" Content="Remove" Classes="danger" />
                        <Border Background="#F9FAFB"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="6">
                            <ListBox Name="TriggerList" Height="300" Background="Transparent" BorderThickness="0">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Add Trigger" Click="TriggerList_AddMenuItem_Click" />
                                        <MenuItem Header="Remove Trigger" Click="TriggerList_RemoveMenuItem_Click" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                            </ListBox>
                        </Border>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Game Data">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14" Spacing="12">
                            <TextBlock Text="Runtime Data Overview"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#374151" />

                            <Border Background="#F9FAFB"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Name="GameDataStatusText"
                                               Text="Game data not loaded."
                                               Foreground="#1F2937"
                                               TextWrapping="Wrap"
                                               FontSize="13" />
                                    <Button Name="GameDataStatusDismissButton"
                                            Content="Dismiss"
                                            MinWidth="90"
                                            HorizontalAlignment="Left"
                                            IsVisible="False" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Dialogues"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#374151" />
                            <Border Background="#FFFFFF"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="6">
                                <ListBox Name="DialogueList"
                                         Height="110"
                                         BorderThickness="0"
                                         Background="Transparent" />
                            </Border>

                            <TextBlock Text="Quests"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#374151" />
                            <Border Background="#FFFFFF"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="6">
                                <ListBox Name="QuestList"
                                         Height="110"
                                         BorderThickness="0"
                                         Background="Transparent" />
                            </Border>

                            <TextBlock Text="Cutscenes"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#374151" />
                            <Border Background="#FFFFFF"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="6">
                                <ListBox Name="CutsceneList"
                                         Height="110"
                                         BorderThickness="0"
                                         Background="Transparent" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <!-- Right Sidebar - Inspector -->
        <Border DockPanel.Dock="Right" 
                Width="300" 
                Background="White" 
                BorderBrush="#E5E7EB" 
                BorderThickness="1,0,0,0">
            <TabControl Name="InspectorTabs">
                <TabItem Header="Layers">
                    <StackPanel Margin="14" Spacing="10">
                        <TextBlock Text="Layer Management"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#374151" />
                        
                        <Grid ColumnDefinitions="*,*">
                            <Button Name="BtnAddLayer" 
                                    Grid.Column="0"
                                    Content="Add" 
                                    Margin="0,0,4,0"
                                    Classes="success" />
                            <Button Name="BtnRemoveLayer" 
                                    Grid.Column="1"
                                    Content="Remove"
                                    Margin="4,0,0,0"
                                    Classes="danger" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*">
                            <Button Name="BtnLayerUp" 
                                    Grid.Column="0"
                                    Content="Move Up" 
                                    Margin="0,0,4,0" />
                            <Button Name="BtnLayerDown" 
                                    Grid.Column="1"
                                    Content="Move Down"
                                    Margin="4,0,0,0" />
                        </Grid>
                        
                        <Border Background="#F9FAFB"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="6">
                            <ListBox Name="LayerList" Height="220" Background="Transparent" BorderThickness="0">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Add Layer" Click="LayerList_AddMenuItem_Click" />
                                        <MenuItem Header="Move Layer Up" Click="LayerList_MoveUpMenuItem_Click" />
                                        <MenuItem Header="Move Layer Down" Click="LayerList_MoveDownMenuItem_Click" />
                                        <MenuItem Header="Toggle Visibility" Click="LayerList_ToggleVisibilityMenuItem_Click" />
                                        <Separator />
                                        <MenuItem Header="Remove Layer" Click="LayerList_RemoveMenuItem_Click" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                            </ListBox>
                        </Border>
                        <CheckBox Name="GridVisibilityCheck" 
                                  Content="Show Grid" 
                                  IsChecked="True"
                                  FontWeight="Medium" />
                        <CheckBox Name="PassabilityOverlayCheck"
                                  Content="Show Collision"
                                  IsChecked="True"
                                  FontWeight="Medium"
                                  Margin="4,6,0,0" />
                    </StackPanel>
                </TabItem>
                <TabItem Header="Properties">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Name="PropertiesPanel" Margin="14" Spacing="8" />
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="History">
                    <StackPanel Margin="14" Spacing="10">
                        <Border Background="#F9FAFB"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="6">
                            <ListBox Name="HistoryList" Height="340" Background="Transparent" BorderThickness="0" />
                        </Border>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Border>

        <!-- Main Canvas Area -->
        <Grid Background="#E5E7EB">
            <Border Margin="12" 
                    Background="White" 
                    BorderBrush="#D1D5DB" 
                    BorderThickness="2" 
                    CornerRadius="10" 
                    Padding="6">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" 
                                      Color="#000000" 
                                      Opacity="0.08"
                                      OffsetY="3" />
                </Border.Effect>
                <TabControl Name="ViewportTabControl">
                    <TabItem Header="Editor">
                        <ScrollViewer Name="ViewportScroll" 
                                      HorizontalScrollBarVisibility="Auto" 
                                      VerticalScrollBarVisibility="Auto">
                            <Canvas Name="MapCanvas"
                                    Background="White"
                                    MinWidth="512"
                                    MinHeight="512"
                                    PointerPressed="MapCanvas_PointerPressed"
                                    PointerMoved="MapCanvas_PointerMoved"
                                    PointerReleased="MapCanvas_PointerReleased"
                                    PointerWheelChanged="MapCanvas_PointerWheelChanged"
                                    PointerExited="MapCanvas_PointerLeave" />
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Preview">
                        <Grid Background="#1F2937">
                            <controls:RuntimePreviewHostControl x:Name="RuntimePreviewHost"
                                                               FallbackBackground="#1F2937"
                                                               HorizontalAlignment="Stretch"
                                                               VerticalAlignment="Stretch" />
                            <Border x:Name="RuntimePreviewStatusOverlay"
                                    Background="#AA111827"
                                    Margin="12"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Padding="24,64,24,24"
                                    IsHitTestVisible="False"
                                    IsVisible="False">
                                <Border Background="#272D3A"
                                        Opacity="0.92"
                                        CornerRadius="12"
                                        Padding="20"
                                        MaxWidth="440"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        Margin="0,16,0,0">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Preview Notice"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="#9CA3AF"
                                                   TextAlignment="Center" />
                                        <TextBlock x:Name="RuntimePreviewStatusText"
                                                   Text="Preview initializing..."
                                                   Foreground="#F9FAFB"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   LineHeight="22" />
                                        <TextBlock x:Name="RuntimePreviewStatusHintText"
                                                   Text="Press Esc or choose Dismiss when ready."
                                                   Foreground="#D1D5DB"
                                                   FontSize="13"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   IsVisible="False" />
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    Spacing="12">
                                            <Button x:Name="RuntimePreviewStatusLoadMapButton"
                                                    Content="Load Map"
                                                    MinWidth="120"
                                                    Classes="primary"
                                                    IsVisible="False"
                                                    Click="RuntimePreviewStatusLoadMapButton_Click" />
                                            <Button x:Name="RuntimePreviewStatusDismissButton"
                                                    Content="Dismiss"
                                                    MinWidth="120"
                                                    IsVisible="False"
                                                    Click="RuntimePreviewStatusDismissButton_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
            <Border Name="DiagnosticsPanel"
                    Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16"
                    Width="380"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Margin="0,16,16,16"
                    IsVisible="False">
                <StackPanel Spacing="12">
                    <DockPanel>
                        <TextBlock Text="Diagnostics &amp; Logging"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   VerticalAlignment="Center" />
                        <Button Name="BtnCloseDiagnostics"
                                Content="Close"
                                MinWidth="70"
                                HorizontalAlignment="Right"
                                Margin="12,0,0,0"
                                DockPanel.Dock="Right" />
                    </DockPanel>
                    <Button Name="BtnCaptureTelemetry"
                            Content="Capture Telemetry"
                            Classes="primary"
                            HorizontalAlignment="Stretch"
                            MinHeight="36" />
                    <TabControl>
                        <TabItem Header="Telemetry">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,8,0,0" Spacing="10">
                                    <TextBlock Name="TelemetryStatusText"
                                               Text="No telemetry captures yet."
                                               Foreground="#374151"
                                               TextWrapping="Wrap" />
                                    <ItemsControl Name="TelemetrySessionsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:CompileBindings="False">
                                                <Border Background="#FFFFFF"
                                                        BorderBrush="#E5E7EB"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="12"
                                                        Margin="0,0,0,10">
                                                    <StackPanel Spacing="8">
                                                        <TextBlock Text="{Binding Header}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#111827" />
                                                        <TextBlock Text="{Binding Summary}"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="#4B5563" />
                                                        <ItemsControl ItemsSource="{Binding Metadata}"
                                                                      IsVisible="{Binding HasMetadata}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:CompileBindings="False">
                                                                    <TextBlock Text="{Binding Display}"
                                                                               FontSize="12"
                                                                               Foreground="#6B7280" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <ItemsControl ItemsSource="{Binding Jobs}"
                                                                      IsVisible="{Binding HasJobs}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:CompileBindings="False">
                                                                    <TextBlock Text="{Binding Summary}"
                                                                               FontSize="12"
                                                                               Foreground="#1F2937" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <Button Content="Open JSON"
                                                                Tag="{Binding JsonPath}"
                                                                HorizontalAlignment="Left"
                                                                MinWidth="110"
                                                                Click="TelemetryOpenJsonButton_Click" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Logs">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ListBox Name="LogList"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Margin="0,8,0,0"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:CompileBindings="False">
                                            <Border Background="#FFFFFF"
                                                    BorderBrush="#E5E7EB"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="10"
                                                    Margin="0,0,0,8">
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="{Binding Header}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding Accent}" />
                                                    <TextBlock Text="{Binding Message}"
                                                               TextWrapping="Wrap"
                                                               Foreground="#111827" />
                                                    <TextBlock Text="{Binding ExceptionMessage}"
                                                               TextWrapping="Wrap"
                                                               Foreground="#9B1C1C"
                                                               IsVisible="{Binding HasException}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>

</Window>

