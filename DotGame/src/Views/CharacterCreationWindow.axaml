<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Dotgame.Avalonia.Views.CharacterCreationWindow"
        Title="Create New Character"
        Width="550" Height="680"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#F9FAFB">
    
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1"
                Padding="28,24">
            <StackPanel Spacing="4">
                <TextBlock Text="Create Your Hero"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#111827" />
                <TextBlock Text="Customize your character and choose their class"
                           FontSize="13"
                           Foreground="#6B7280" />
            </StackPanel>
        </Border>
        
        <!-- Content -->
        <ScrollViewer Grid.Row="1" Padding="28,24">
            <StackPanel Spacing="20">
                <!-- Sprite Section -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Character Sprite"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#374151" />
                    
                    <Border Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">
                        <StackPanel Spacing="14">
                            <TextBox Name="TxtSpritePath" 
                                     Watermark="Enter sprite path or leave blank for default sprite"
                                     Height="42" />
                            
                <Button Name="BtnLoadSprite" 
                    Content="Browse for Sprite"
                                    Height="38"
                                    HorizontalAlignment="Left"
                                    Click="BtnLoadSprite_Click" />
                            
                            <Border BorderBrush="#E5E7EB" 
                                    BorderThickness="2" 
                                    CornerRadius="10"
                                    Height="140"
                                    Background="#F9FAFB">
                                <Image Name="ImgPreview" 
                                       Stretch="Uniform"
                                       Margin="10" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
                
                <!-- Character Info Section -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Character Details"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#374151" />
                    
                    <Border Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Name" 
                                           FontSize="14"
                                           FontWeight="Medium"
                                           Foreground="#4B5563" />
                                <TextBox Name="TxtName" 
                                         Watermark="Enter your character's name"
                                         Height="42" />
                            </StackPanel>
                            
                            <StackPanel Spacing="8">
                                <TextBlock Text="Class" 
                                           FontSize="14"
                                           FontWeight="Medium"
                                           Foreground="#4B5563" />
                                <ComboBox Name="CmbClass" 
                                          SelectedIndex="0"
                                          Height="42">
                                    <ComboBoxItem>Warrior</ComboBoxItem>
                                    <ComboBoxItem>Mage</ComboBoxItem>
                                    <ComboBoxItem>Thief</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                
                <!-- Class Info Section -->
                <Border Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Class Overview"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#374151" />
                        
                        <Border Background="#F9FAFB"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14">
                            <StackPanel Spacing="8">
                                <TextBlock Name="LblClassDesc" 
                                           FontStyle="Italic" 
                                           Foreground="#6B7280"
                                           FontSize="13"
                                           TextWrapping="Wrap" />
                                <TextBlock Name="LblStats" 
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           TextWrapping="Wrap" 
                                           Foreground="#111827" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                
                <!-- Action Buttons Section -->
                <Border Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
            <Button Name="BtnSaveUnit" 
                Grid.Column="0" Grid.Row="0"
                Content="Save Unit"
                                Height="42"
                                Margin="0,0,5,0"
                                Classes="primary" />
                        <Button Name="BtnAddToMap" 
                                Grid.Column="1" Grid.Row="0"
                Content="Add to Map"
                                Height="42"
                                Margin="5,0,0,0"
                                Classes="success" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
        
        <!-- Footer -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0"
                Padding="28,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Name="BtnCancel" 
                        Content="Cancel"
                        Width="100" 
                        Height="40" />
                <Button Name="BtnOk" 
                        Content="Create"
                        Width="100" 
                        Height="40"
                        Classes="primary" />
            </StackPanel>
        </Border>
    </Grid>
    
</Window>

