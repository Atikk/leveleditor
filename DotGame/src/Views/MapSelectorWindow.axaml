<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DotGameAvalonia.Views.MapSelectorWindow"
        Title="Select Map"
        Width="400" Height="300"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    
    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="Select a map to load:" FontWeight="Bold" />
        <TextBlock Text="Map path or URL:" />
        <TextBox Name="TxtMapPath" Watermark="Enter path to .json map file" />
        <TextBlock Text="Or select from samples:" />
        <ListBox Name="LstMaps" Height="100">
        </ListBox>
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
            <Button Name="BtnOk" Content="Load Map" Width="100" Height="35" />
            <Button Name="BtnCancel" Content="Cancel" Width="80" Height="35" />
        </StackPanel>
    </StackPanel>
    
</Window>
