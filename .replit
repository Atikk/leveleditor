modules = ["nodejs-20", "dotnet-7.0", "web", "dotnet-8.0", "python-3.11"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["dbus", "fluxbox", "fontconfig", "libgdiplus", "novnc", "samba4Full", "tigervnc", "wget", "xorg.libICE", "xorg.libSM", "xorg.xinit", "xorg.xorgserver", "xterm", "xvfb-run"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "DotGame"

[[workflows.workflow]]
name = "DotGame"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "./start-app.sh"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 45059
externalPort = 3000
